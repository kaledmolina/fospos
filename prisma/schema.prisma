generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Negocio/Tienda - Cada tenant es un negocio independiente
model Tenant {
  id                    String                 @id @default(cuid())
  businessName          String
  nit                   String                 @unique
  ownerName             String
  phone                 String
  email                 String
  city                  String
  address               String?
  status                TenantStatus           @default(PENDING)
  currency              String                 @default("COP")
  taxRate               Float                  @default(19.0)
  invoicePrefix         String                 @default("FAC")
  invoiceNumber         Int                    @default(1)
  logoUrl               String?
  enabledPaymentMethods String                 @default("CASH,CARD,TRANSFER,CREDIT,MIXED,GIFT_CARD")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  activatedAt           DateTime?
  activationCode        ActivationCode?
  activityLogs          ActivityLog[]
  branches              Branch[]
  cashRegisters         CashRegister[]
  categories            Category[]
  coupons               Coupon[]
  credits               Credit[]
  subscriptions         CustomerSubscription[]
  customers             Customer[]
  expenses              Expense[]
  giftCards             GiftCard[]
  inventoryMovements    InventoryMovement[]
  notifications         Notification[]
  pointConfig           PointConfig?
  products              Product[]
  purchaseOrders        PurchaseOrder[]
  sales                 Sale[]
  subscriptionServices  SubscriptionService[]
  suppliers             Supplier[]
  users                 User[]

  @@map("tenants")
}

/// Sucursal del negocio
model Branch {
  id                    String              @id @default(cuid())
  tenantId              String
  name                  String
  address               String?
  phone                 String?
  city                  String?
  isActive              Boolean             @default(true)
  isMain                Boolean             @default(false)
  monthlyGoal           Float               @default(0)
  logoUrl               String?
  themeColor            String?             @default("#10b981")
  enabledPaymentMethods String?             @default("CASH,CARD,TRANSFER,CREDIT,MIXED,GIFT_CARD")
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  tenant                Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cashRegisters         CashRegister[]
  categories            Category[]
  credits               Credit[]
  expenses              Expense[]
  inventoryMovements    InventoryMovement[]
  batches               ProductBatch[]
  productStock          ProductStock[]
  products              Product[]
  purchaseOrders        PurchaseOrder[]
  sales                 Sale[]
  users                 User[]              @relation("UserBranches")

  @@unique([tenantId, name])
  @@map("branches")
}

/// Usuario del sistema (Super Admin o usuario de negocio)
model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  password           String
  name               String
  role               UserRole            @default(CASHIER)
  tenantId           String?
  isActive           Boolean             @default(true)
  phone              String?
  theme              String              @default("light")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  lastLogin          DateTime?
  activityLogs       ActivityLog[]
  closedRegisters    CashRegister[]      @relation("ClosedBy")
  openedRegisters    CashRegister[]      @relation("OpenedBy")
  creditPayments     CreditPayment[]
  inventoryMovements InventoryMovement[]
  tenant             Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branches           Branch[]            @relation("UserBranches")

  @@map("users")
}

/// Proveedor de productos
model Supplier {
  id                 String              @id @default(cuid())
  tenantId           String
  name               String
  nit                String?
  phone              String?
  email              String?
  address            String?
  notes              String?
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  inventoryMovements InventoryMovement[]
  batches            ProductBatch[]
  products           Product[]
  purchaseOrders     PurchaseOrder[]
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@map("suppliers")
}

/// Categoría de productos
model Category {
  id                   String                @id @default(cuid())
  tenantId             String
  branchId             String?
  name                 String
  description          String?
  color                String?
  icon                 String?
  imageUrl             String?
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  branch               Branch?               @relation(fields: [branchId], references: [id])
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products             Product[]
  subscriptionServices SubscriptionService[]

  @@unique([tenantId, name])
  @@map("categories")
}

/// Producto del inventario
model Product {
  id                 String                @id @default(cuid())
  tenantId           String
  branchId           String?
  categoryId         String?
  code               String?
  sku                String?
  name               String
  description        String?
  imageUrl           String?
  costPrice          Float                 @default(0)
  salePrice          Float
  wholesalePrice     Float?
  stock              Float                 @default(0)
  minStock           Float                 @default(5)
  maxStock           Float                 @default(100)
  unit               String                @default("unidad")
  isActive           Boolean               @default(true)
  expiryDate         DateTime?
  supplierId         String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  movements          InventoryMovement[]
  batches            ProductBatch[]
  presentations      ProductPresentation[]
  stockByBranch      ProductStock[]
  supplier           Supplier?             @relation(fields: [supplierId], references: [id])
  category           Category?             @relation(fields: [categoryId], references: [id])
  branch             Branch?               @relation(fields: [branchId], references: [id])
  tenant             Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrderItems PurchaseOrderItem[]
  saleItems          SaleItem[]

  @@unique([tenantId, code])
  @@unique([tenantId, sku])
  @@map("products")
}

/// Lote específico de un producto (manejo de múltiples costos/proveedores)
model ProductBatch {
  id          String              @id @default(cuid())
  productId   String
  branchId    String
  supplierId  String?
  batchNumber String?
  quantity    Float               @default(0)
  costPrice   Float               @default(0)
  salePrice   Float               @default(0)
  expiryDate  DateTime?
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  movements   InventoryMovement[]
  supplier    Supplier?           @relation(fields: [supplierId], references: [id])
  branch      Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product     Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  saleItems   SaleItem[]

  @@map("product_batches")
}

/// Stock por sucursal
model ProductStock {
  id        String   @id @default(cuid())
  productId String
  branchId  String
  stock     Float    @default(0)
  minStock  Float    @default(5)
  updatedAt DateTime @updatedAt
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, branchId])
  @@map("product_stock")
}

/// Movimientos de inventario
model InventoryMovement {
  id            String        @id @default(cuid())
  tenantId      String
  productId     String
  branchId      String
  type          MovementType
  quantity      Float
  previousStock Float
  newStock      Float
  referenceType String?
  referenceId   String?
  supplierId    String?
  batchId       String?
  unitCost      Float?        @default(0)
  totalCost     Float?        @default(0)
  notes         String?
  reason        String?
  createdBy     String
  createdAt     DateTime      @default(now())
  creator       User          @relation(fields: [createdBy], references: [id])
  batch         ProductBatch? @relation(fields: [batchId], references: [id])
  supplier      Supplier?     @relation(fields: [supplierId], references: [id])
  branch        Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("inventory_movements")
}

/// Presentaciones de venta de un producto (ej: Libra de un producto en KG)
model ProductPresentation {
  id               String     @id @default(cuid())
  productId        String
  name             String
  unit             String
  conversionFactor Float
  price            Float?
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  product          Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  saleItems        SaleItem[]

  @@map("product_presentations")
}

/// Cliente del negocio
model Customer {
  id             String                 @id @default(cuid())
  tenantId       String
  documentType   String?                @default("CC")
  document       String?
  name           String
  phone          String?
  email          String?
  address        String?
  notes          String?
  creditLimit    Float                  @default(0)
  totalPurchases Float                  @default(0)
  points         Int                    @default(0)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  credits        Credit[]
  subscriptions  CustomerSubscription[]
  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  giftCards      GiftCard[]
  sales          Sale[]

  @@unique([tenantId, document])
  @@map("customers")
}

/// Venta/Transacción
model Sale {
  id                  String               @id @default(cuid())
  tenantId            String
  branchId            String?
  customerId          String?
  invoiceNumber       String               @default("")
  subtotal            Float                @default(0)
  tax                 Float                @default(0)
  discount            Float                @default(0)
  pointsRedeemed      Int                  @default(0)
  pointsEarned        Int                  @default(0)
  pointsValue         Float                @default(0)
  total               Float
  totalCost           Float                @default(0)
  paymentMethod       PaymentMethod        @default(CASH)
  paymentStatus       PaymentStatus        @default(PAID)
  cashReceived        Float?
  change              Float?
  creditId            String?              @unique
  cashRegisterId      String?
  notes               String?
  createdAt           DateTime             @default(now())
  credit              Credit?
  giftCardRedemptions GiftCardRedemption[]
  giftCardSold        GiftCard[]           @relation("GiftCardSold")
  items               SaleItem[]
  payments            SalePayment[]
  customer            Customer?            @relation(fields: [customerId], references: [id])
  branch              Branch?              @relation(fields: [branchId], references: [id])
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, invoiceNumber])
  @@map("sales")
}

/// Item de una venta
model SaleItem {
  id             String               @id @default(cuid())
  saleId         String
  productId      String?
  productName    String
  productCode    String?
  unitPrice      Float
  costPrice      Float                @default(0)
  quantity       Float
  unit           String               @default("unidad")
  discount       Float                @default(0)
  subtotal       Float
  batchId        String?
  presentationId String?
  presentation   ProductPresentation? @relation(fields: [presentationId], references: [id])
  batch          ProductBatch?        @relation(fields: [batchId], references: [id])
  product        Product?             @relation(fields: [productId], references: [id])
  sale           Sale                 @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("sale_items")
}

/// Registro de cada pago de una venta (para pagos mixtos)
model SalePayment {
  id        String        @id @default(cuid())
  saleId    String
  method    PaymentMethod
  amount    Float
  notes     String?
  createdAt DateTime      @default(now())
  sale      Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("sale_payments")
}

/// Orden de Compra a proveedor
model PurchaseOrder {
  id          String              @id @default(cuid())
  tenantId    String
  supplierId  String
  branchId    String?
  status      PurchaseOrderStatus @default(PENDING)
  totalAmount Float               @default(0)
  notes       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  items       PurchaseOrderItem[]
  branch      Branch?             @relation(fields: [branchId], references: [id])
  supplier    Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("purchase_orders")
}

/// Item de una orden de compra
model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  productId       String
  quantity        Float
  unitCost        Float
  subtotal        Float
  batchNumber     String?
  expiryDate      DateTime?
  salePrice       Float?
  batchId         String?
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@map("purchase_order_items")
}

/// Crédito/Fiado de cliente
model Credit {
  id             String          @id @default(cuid())
  tenantId       String
  customerId     String
  saleId         String?         @unique
  branchId       String?
  totalAmount    Float
  paidAmount     Float           @default(0)
  balance        Float
  interestRate   Float           @default(0)
  interestAmount Float           @default(0)
  status         CreditStatus    @default(PENDING)
  dueDate        DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  payments       CreditPayment[]
  branch         Branch?         @relation(fields: [branchId], references: [id])
  sale           Sale?           @relation(fields: [saleId], references: [id])
  customer       Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("credits")
}

/// Abono a un crédito
model CreditPayment {
  id             String        @id @default(cuid())
  creditId       String
  amount         Float
  paymentMethod  PaymentMethod @default(CASH)
  notes          String?
  registeredById String?
  receiptNumber  String?       @default("")
  createdAt      DateTime      @default(now())
  registeredBy   User?         @relation(fields: [registeredById], references: [id])
  credit         Credit        @relation(fields: [creditId], references: [id], onDelete: Cascade)

  @@map("credit_payments")
}

/// Caja registradora
model CashRegister {
  id            String             @id @default(cuid())
  tenantId      String
  branchId      String?
  name          String             @default("Caja Principal")
  openedAt      DateTime           @default(now())
  openedBy      String
  initialCash   Float              @default(0)
  closedAt      DateTime?
  closedBy      String?
  finalCash     Float?
  status        CashRegisterStatus @default(OPEN)
  totalSales    Float              @default(0)
  totalCash     Float              @default(0)
  totalCard     Float              @default(0)
  totalTransfer Float              @default(0)
  totalCredit   Float              @default(0)
  totalGiftCard Float              @default(0)
  totalExpenses Float              @default(0)
  difference    Float?
  notes         String?
  closedByUser  User?              @relation("ClosedBy", fields: [closedBy], references: [id])
  openedByUser  User               @relation("OpenedBy", fields: [openedBy], references: [id])
  branch        Branch?            @relation(fields: [branchId], references: [id])
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("cash_registers")
}

/// Gasto del negocio
model Expense {
  id             String   @id @default(cuid())
  tenantId       String
  branchId       String?
  category       String
  description    String
  amount         Float
  date           DateTime @default(now())
  receiptUrl     String?
  cashRegisterId String?
  createdBy      String
  notes          String?
  createdAt      DateTime @default(now())
  branch         Branch?  @relation(fields: [branchId], references: [id])
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("expenses")
}

/// Notificación del sistema
model Notification {
  id            String           @id @default(cuid())
  tenantId      String
  type          NotificationType
  title         String
  message       String
  referenceType String?
  referenceId   String?
  isRead        Boolean          @default(false)
  createdAt     DateTime         @default(now())
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

/// Servicio de suscripción (sin stock) - Gimnasios, Membresías, Streaming, etc.
model SubscriptionService {
  id             String                 @id @default(cuid())
  tenantId       String
  categoryId     String?
  code           String?
  name           String
  description    String?
  imageUrl       String?
  price          Float
  setupFee       Float                  @default(0)
  billingCycle   BillingCycle           @default(MONTHLY)
  billingDays    Int                    @default(30)
  durationMonths Int?
  isActive       Boolean                @default(true)
  maxFreezes     Int                    @default(0)
  freezeDaysMax  Int                    @default(0)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  subscriptions  CustomerSubscription[]
  category       Category?              @relation(fields: [categoryId], references: [id])
  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@map("subscription_services")
}

/// Suscripción de cliente a un servicio
model CustomerSubscription {
  id              String                @id @default(cuid())
  tenantId        String
  customerId      String
  serviceId       String
  startDate       DateTime              @default(now())
  endDate         DateTime?
  nextBillingDate DateTime
  lastPaymentDate DateTime?
  status          SubscriptionStatus    @default(ACTIVE)
  agreedPrice     Float
  frozenAt        DateTime?
  frozenUntil     DateTime?
  freezeCount     Int                   @default(0)
  discountPercent Float                 @default(0)
  discountReason  String?
  notes           String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  service         SubscriptionService   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  customer        Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments        SubscriptionPayment[]

  @@map("customer_subscriptions")
}

/// Pago de suscripción
model SubscriptionPayment {
  id             String               @id @default(cuid())
  subscriptionId String
  amount         Float
  paymentMethod  PaymentMethod        @default(CASH)
  periodStart    DateTime
  periodEnd      DateTime
  status         PaymentStatus        @default(PAID)
  receiptNumber  String?              @default("")
  notes          String?
  createdAt      DateTime             @default(now())
  subscription   CustomerSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("subscription_payments")
}

/// Configuración de puntos de fidelización por tenant
model PointConfig {
  id                String   @id @default(cuid())
  tenantId          String   @unique
  pointsPerAmount   Int      @default(1)
  amountStep        Float    @default(1000)
  redemptionValue   Float    @default(10)
  minPointsToRedeem Int      @default(100)
  isActive          Boolean  @default(false)
  updatedAt         DateTime @updatedAt
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("point_configs")
}

/// Cupones de descuento
model Coupon {
  id          String     @id @default(cuid())
  tenantId    String
  code        String
  description String?
  type        CouponType @default(FIXED)
  value       Float
  minPurchase Float      @default(0)
  maxUses     Int?
  currentUses Int        @default(0)
  startsAt    DateTime   @default(now())
  expiresAt   DateTime?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@map("coupons")
}

/// Códigos de activación para registro instantáneo
model ActivationCode {
  id        String    @id @default(cuid())
  code      String    @unique
  isUsed    Boolean   @default(false)
  usedAt    DateTime?
  tenantId  String?   @unique
  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tenant    Tenant?   @relation(fields: [tenantId], references: [id])

  @@map("activation_codes")
}

/// Tarjeta de regalo emitida por una tienda
model GiftCard {
  id            String               @id @default(cuid())
  tenantId      String
  customerId    String?
  code          String               @unique
  balance       Float
  initialAmount Float
  status        GiftCardStatus       @default(ACTIVE)
  expiresAt     DateTime?
  isActive      Boolean              @default(true)
  saleId        String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  redemptions   GiftCardRedemption[]
  sale          Sale?                @relation("GiftCardSold", fields: [saleId], references: [id])
  customer      Customer?            @relation(fields: [customerId], references: [id])
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@map("gift_cards")
}

/// Registro de cada vez que se usa una tarjeta de regalo
model GiftCardRedemption {
  id         String   @id @default(cuid())
  giftCardId String
  saleId     String
  amountUsed Float
  createdAt  DateTime @default(now())
  sale       Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  giftCard   GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)

  @@map("gift_card_redemptions")
}

model ActivityLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldValue  String?
  newValue  String?
  notes     String?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("activity_logs")
}

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum UserRole {
  SUPER_ADMIN
  TENANT_ADMIN
  CASHIER
  WAREHOUSE
}

enum MovementType {
  IN
  OUT
  SALE
  PURCHASE
  ADJUSTMENT
  TRANSFER
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  CREDIT
  MIXED
  GIFT_CARD
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  CANCELLED
}

enum PurchaseOrderStatus {
  PENDING
  RECEIVED
  CANCELLED
}

enum CreditStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

enum CashRegisterStatus {
  OPEN
  CLOSED
}

enum NotificationType {
  LOW_STOCK
  CREDIT_DUE
  CREDIT_OVERDUE
  NEW_SALE
  DAILY_SUMMARY
  SYSTEM
}

enum BillingCycle {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  YEARLY
  CUSTOM
}

enum SubscriptionStatus {
  ACTIVE
  PENDING
  PAUSED
  OVERDUE
  CANCELLED
  COMPLETED
}

enum CouponType {
  FIXED
  PERCENTAGE
}

enum GiftCardStatus {
  ACTIVE
  EXPIRED
  USED_UP
  CANCELLED
}
